# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Stripe (https://dashboard.stripe.com/apikeys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# Subscription price IDs from Stripe Products
STRIPE_INVESTOR_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Supabase (https://supabase.com/dashboard → Project Settings → API)
# Use the full Project URL including https:// (e.g. https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only: used by /api/deals and /api/profile (never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# GreatSchools API (https://www.greatschools.org/api/) — school district ratings
GREATSCHOOLS_API_KEY=

# Vercel cron auth for /api/cron/refresh-location-data
CRON_SECRET=

# Optional: used for checkout success/cancel URLs when Origin header is missing
NEXT_PUBLIC_APP_URL=http://localhost:3000
